{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prebuild": "pnpm run historical:refresh && pnpm run historical:check && pnpm run model:check",
    "dev": "vinext dev",
    "build": "vinext build",
    "historical:refresh": "node scripts/build-historical-backtest.mjs",
    "historical:check": "node scripts/verify-historical-benchmark.mjs",
    "model:check": "node scripts/verify-model-integrity.mjs",
    "failure:atlas": "node scripts/build-failure-atlas.mjs",
    "shadow:residual": "node scripts/build-shadow-residual-backtest.mjs",
    "residual:robustness": "node scripts/build-residual-robustness.mjs",
    "historical:v6": "node scripts/build-historical-v6.mjs",
    "v5:artifact": "node scripts/build-v5-prospective-artifact.mjs",
    "test:prospective-shadow": "node scripts/test-prospective-shadow.mjs",
    "typecheck": "tsc --noEmit",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "db:generate": "drizzle-kit generate",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.1",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.0",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.7",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
